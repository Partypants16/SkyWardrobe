# OpenWeatherMap API Key (Server-side proxy)
# Get a free key at https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_api_key_here

# Default City for Weather Queries
OPENWEATHER_CITY=Melbourne,AU

# Server Port (Default: 3000)
PORT=3000

# SQLite Database Location (Optional, default: /app/data/wardrobe.db in Docker Compose)
DATABASE_PATH=/app/data/wardrobe.db
